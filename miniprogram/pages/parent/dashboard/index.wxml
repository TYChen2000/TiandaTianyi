<view class="container">
  <view class="card">
    <view class="section-title">孩子信息</view>
    <view>姓名：{{childName}}</view>
    <view>班级：{{className}}</view>
    <view>上课时间：{{classTime}}</view>
    <view>累计奖励：{{rewardTotal}}</view>
  </view>

  <view wx:if="{{loading}}">正在加载...</view>
  <view wx:elif="{{error}}">{{error}}</view>
  <view wx:else>
    <view class="card">
      <view class="section-title">最近一次课程反馈</view>
      <view wx:if="{{!latestRecord}}">暂无反馈</view>
      <view wx:else>
        <view>出勤：{{latestRecord.attendance}}</view>
        <view>星级：{{latestRecord.rating}}</view>
        <view>评语：{{latestRecord.comment || '暂无'}}</view>
        <view>要求：{{latestRecord.requirements || '无'}}</view>
        <view>奖励：{{latestRecord.reward}}</view>
      </view>
    </view>

    <view class="btn-primary" bindtap="goHistory">查看历史课程记录</view>
  </view>
</view>
